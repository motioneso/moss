pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 64; }
http {
    include /etc/nginx/mime.types;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $http_origin $computer_origin_allowed {
        default 0;
        "https://localhost:${COMPUTER_PORT}" 1;
    }
    upstream desktop { server unix:/socket/viewer.sock; }
    server {
        listen 8443 ssl;
        server_name localhost;
        ssl_certificate /gateway/server.crt;
        ssl_certificate_key /gateway/server.key;
        ssl_client_certificate /gateway/ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache off;
        ssl_session_tickets off;
        root /usr/share/novnc;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        location = /websockify {
            if ($computer_origin_allowed = 0) { return 403; }
            proxy_pass http://desktop;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_buffering off;
            proxy_read_timeout 65s;
        }
        location / { try_files $uri =404; }
    }
}
