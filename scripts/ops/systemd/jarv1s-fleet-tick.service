[Unit]
Description=Jarv1s fleet daemon tick -- advance every lane one step

[Service]
Type=oneshot
# Type=oneshot disables the start timeout by default, so one wedged tick
# (a hung gh call, a stalled model call) would stop the daemon silently and
# forever. Cap it: systemd kills the stuck run and the timer starts a fresh
# tick a minute later.
TimeoutStartSec=10min
Environment=JARV1S_FLEET_STATE=/home/ben/.local/state/jarv1s-fleet
# Judgment calls and build-agent spawns are provider-agnostic. Configuration
# normally comes from settings.json in the state folder (written by the fleet
# launcher's setup questions). Environment variables set HERE override that
# file -- an uncommented line below silently shadows every answer given at
# setup, so keep these commented unless you mean to pin a value.
#
# Pinning FLEET_BUILD_MODEL alone does NOT inherit the settings file's effort
# level -- that effort was chosen for the model the file names. Pin both or
# neither; model-only falls back to the CLI's own default effort.
#Environment=FLEET_JUDGE_CMD=claude -p
#Environment=FLEET_BUILD_MODEL=<model>
#Environment=FLEET_BUILD_EFFORT=<effort>
#Environment=FLEET_LANE_CAP=3
#Environment=FLEET_SPAWN_BUDGET=12
#Environment=FLEET_DEPUTY_ENABLED=false
#Environment=FLEET_DEPUTY_WAIT_SECONDS=1200
# Free-memory floor in MB below which no new agent starts; 0 disables the
# check. Also settable as memoryFloorMb in settings.json. Raise it if the box
# swaps, lower it if the fleet refuses to spawn on a machine with less RAM.
#Environment=FLEET_MEMORY_FLOOR_MB=4096
# Where free memory is read from. Only for testing; leave it alone in
# production.
#Environment=FLEET_MEMINFO=/proc/meminfo
ExecStart=/home/ben/Jarv1s/scripts/fleet/tick.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarv1s-fleet-tick
