#!/usr/bin/env bash
# Formats staged files with Prettier so a commit never fails the CI format check.
# Files that also have unstaged edits are only checked, so a partial stage is never widened.
set -euo pipefail

prettier="node_modules/.bin/prettier"
if [ ! -x "$prettier" ]; then
  echo "pre-commit: prettier is not installed, skipping formatting" >&2
  exit 0
fi

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#staged[@]}" -gt 0 ] || exit 0

mapfile -d '' unstaged < <(git diff --name-only -z)
declare -A has_unstaged=()
for file in "${unstaged[@]}"; do has_unstaged["$file"]=1; done

whole=()
partial=()
for file in "${staged[@]}"; do
  if [ -n "${has_unstaged[$file]:-}" ]; then partial+=("$file"); else whole+=("$file"); fi
done

if [ "${#whole[@]}" -gt 0 ]; then
  "$prettier" --write --ignore-unknown --log-level warn -- "${whole[@]}"
  git add -f -- "${whole[@]}"
fi

if [ "${#partial[@]}" -gt 0 ] && ! "$prettier" --check --ignore-unknown --log-level warn -- "${partial[@]}"; then
  echo "pre-commit: the files above are partly staged and need formatting; run prettier --write on them, re-stage, and commit again" >&2
  exit 1
fi
