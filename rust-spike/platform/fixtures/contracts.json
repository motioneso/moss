[
  {
    "name": "metadata payload admitted",
    "path": "/probe/payload",
    "body": {
      "queue": {
        "name": "tasks.defer",
        "moduleId": "tasks",
        "jobKinds": ["defer"],
        "paramsSchema": {
          "type": "object",
          "fields": {
            "taskId": {
              "type": "uuid"
            },
            "requestedStatus": {
              "type": "enum",
              "values": ["todo", "done"]
            }
          }
        },
        "retryLimit": 3,
        "retryDelaySeconds": 1,
        "retryBackoff": true,
        "leaseSeconds": 60
      },
      "payload": {
        "actorUserId": "00000000-0000-4000-8000-000000000001",
        "moduleId": "tasks",
        "jobKind": "defer",
        "manifestHash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "params": {
          "taskId": "00000000-0000-4000-8000-000000000100",
          "requestedStatus": "done"
        }
      }
    },
    "expected": {
      "accepted": true
    }
  },
