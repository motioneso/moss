[
  {
    "name": "verticals 284: task list returns a tags array on every task",
    "source": "tasks-verticals.test.ts:284 GET /api/tasks returns tags and rolls a stale recurring series forward (lazy-on-view)",
    "steps": [
      {
        "id": "make",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "lazy roll"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "list",
        "method": "GET",
        "path": "/api/tasks",
        "as": "A",
        "expect": {
          "body": {
            "tasks": [
              {
                "title": "lazy roll",
                "tags": []
              }
            ]
          },
          "status": 200
        }
      }
    ],
    "rows": ["app.tasks"],
    "note": "Tags part only. The test also makes a weekly series with a stale date and checks a read rolls it forward; roll-forward is not ported, so the task here is not recurring."
  },
  {
    "name": "verticals 334: lists route returns the actor's lists",
    "source": "tasks-verticals.test.ts:334 GET /api/tasks/lists returns the actor's lists",
    "steps": [
      {
        "id": "seed",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "first task"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "lists",
        "method": "GET",
        "path": "/api/tasks/lists",
        "as": "A",
        "expect": {
          "body": {
            "lists": [
              {
                "name": "Personal"
              }
            ]
          },
          "status": 200
        }
      }
    ],
    "rows": ["app.task_lists"],
    "note": "Exact one-list check instead of 'contains Personal'. Personal is made by the first task create (the test's seed data makes tasks first), so the case creates one."
  },
  {
    "name": "verticals 346: creating a list is get-or-create",
    "source": "tasks-verticals.test.ts:346 POST /api/tasks/lists creates a list (idempotent)",
    "steps": [
      {
        "id": "one",
        "method": "POST",
        "path": "/api/tasks/lists",
        "as": "A",
        "body": {
          "name": "Work"
        },
        "expect": {
          "body": {
            "list": {
              "name": "Work"
            }
          },
          "status": 201
        }
      },
      {
        "id": "two",
        "method": "POST",
        "path": "/api/tasks/lists",
        "as": "A",
        "body": {
          "name": "Work"
        },
        "expect": {
          "body": {
            "list": {
              "id": "{{one:/body/list/id}}"
            }
          },
          "status": 201
        }
      }
    ],
    "rows": ["app.task_lists"]
  },
  {
    "name": "verticals 369: tag created on a list",
    "source": "tasks-verticals.test.ts:369 POST /api/tasks/lists/:listId/tags creates a tag on the list",
    "steps": [
      {
        "id": "seed",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "first task"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "lists",
        "method": "GET",
        "path": "/api/tasks/lists",
        "as": "A",
        "expect": {
          "status": 200
        }
      },
      {
        "id": "tag",
        "method": "POST",
        "path": "/api/tasks/lists/{{lists:/body/lists/0/id}}/tags",
        "as": "A",
        "body": {
          "name": "urgent"
        },
        "expect": {
          "body": {
            "tag": {
              "name": "urgent",
              "listId": "{{lists:/body/lists/0/id}}"
            }
          },
          "status": 201
        }
      }
    ],
    "rows": ["app.task_lists", "app.task_tags"],
    "note": "The test reads the Personal list through the repository; this case reads it through the lists route."
  },
