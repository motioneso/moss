  {
    "name": "verticals 440: quadrant filter keeps the important and urgent task",
    "source": "tasks-verticals.test.ts:440 GET /api/tasks?quadrant=do filters by Eisenhower quadrant",
    "steps": [
      {
        "id": "do",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "quadrant-do-test",
          "priority": 5,
          "dueAt": "{{now+1h}}"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "later",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "quadrant-schedule-test",
          "priority": 5,
          "dueAt": "{{now+10d}}"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "filtered",
        "method": "GET",
        "path": "/api/tasks?quadrant=do",
        "as": "A",
        "expect": {
          "body": {
            "tasks": [
              {
                "title": "quadrant-do-test"
              }
            ]
          },
          "status": 200
        }
      },
      {
        "id": "bad",
        "method": "GET",
        "path": "/api/tasks?quadrant=nope",
        "as": "A",
        "expect": {
          "status": 400
        }
      }
    ],
    "note": "Adds a second task in another quadrant and a bad quadrant value, so the filter is shown to filter."
  },
