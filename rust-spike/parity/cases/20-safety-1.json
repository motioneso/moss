  {
    "name": "safety: account lifecycle, pending to approved to deactivated and back",
    "source": "packages/settings/src/routes.ts admin routes; packages/auth resolveRequestAccessContext",
    "seed": [
      "update app.users set is_bootstrap_owner = true where id = '{{admin}}'",
      "insert into app.instance_settings (key, value) values ('registration.enabled', '{\"value\": true}'::jsonb), ('registration.requires_approval', '{\"value\": true}'::jsonb) on conflict (key) do update set value = excluded.value"
    ],
    "steps": [
      {
        "id": "sign up",
        "method": "POST",
        "path": "/api/auth/sign-up/email",
        "body": {
          "email": "new-member@example.test",
          "password": "MOSS-SENTINEL-lifecycle-pass",
          "name": "New Member"
        },
        "save_cookie": "first",
        "compare": ["/status", "/body/user", "/cookies"],
        "absent": ["MOSS-SENTINEL-"],
        "expect": {
          "status": 200
        }
      },
      {
        "id": "pending member is held",
        "method": "GET",
        "path": "/api/me",
        "cookie": "first",
        "expect": {
          "status": 403
        }
      },
      {
        "id": "approve",
        "method": "POST",
        "path": "/api/admin/users/{{sign up:/body/user/id}}/approve",
        "as": "admin",
        "expect": {
          "status": 200,
          "body": {
            "user": {
              "status": "active"
            }
          }
        }
      },
      {
        "id": "approved member gets in",
        "method": "GET",
        "path": "/api/me",
        "cookie": "first",
        "expect": {
          "status": 200
        }
      },
      {
        "id": "approve again",
        "method": "POST",
        "path": "/api/admin/users/{{sign up:/body/user/id}}/approve",
        "as": "admin",
        "expect": {
          "status": 409
        }
      },
      {
        "id": "deactivate",
        "method": "POST",
        "path": "/api/admin/users/{{sign up:/body/user/id}}/deactivate",
        "as": "admin",
        "expect": {
          "status": 200,
          "body": {
            "user": {
              "status": "deactivated"
            }
          }
        }
      },
      {
        "id": "deactivation ended the session",
        "method": "GET",
        "path": "/api/me",
        "cookie": "first",
        "expect": {
          "status": 401
        }
      },
      {
        "id": "sign in while deactivated",
        "method": "POST",
        "path": "/api/auth/sign-in/email",
        "body": {
          "email": "new-member@example.test",
          "password": "MOSS-SENTINEL-lifecycle-pass"
        },
        "save_cookie": "second",
        "compare": ["/status", "/body/redirect", "/body/user", "/cookies"],
        "absent": ["MOSS-SENTINEL-"],
        "expect": {
          "status": 200
        }
      },
      {
        "id": "deactivated member is held",
        "method": "GET",
        "path": "/api/me",
        "cookie": "second",
        "expect": {
          "status": 403
        }
      },
      {
        "id": "reactivate",
        "method": "POST",
        "path": "/api/admin/users/{{sign up:/body/user/id}}/reactivate",
        "as": "admin",
        "expect": {
          "status": 200,
          "body": {
            "user": {
              "status": "active"
            }
          }
        }
      },
      {
        "id": "reactivated member gets in",
        "method": "GET",
        "path": "/api/me",
        "cookie": "second",
        "expect": {
          "status": 200
        }
      },
      {
        "id": "the ended session stays ended",
        "method": "GET",
        "path": "/api/me",
        "cookie": "first",
        "expect": {
          "status": 401
        }
      },
      {
        "id": "sign out",
        "method": "POST",
        "path": "/api/auth/sign-out",
        "cookie": "second",
        "compare": ["/status", "/body", "/cookies"],
        "expect": {
          "status": 200
        }
      },
      {
        "id": "signed-out session is refused",
        "method": "GET",
        "path": "/api/me",
        "cookie": "second",
        "expect": {
          "status": 401
        }
      },
      {
        "id": "audit trail, request ids by presence only",
        "sql": "select actor_user_id, action, target_type, target_id, metadata, request_id is not null as has_request_id from app.admin_audit_events order by created_at, action",
        "as": "admin",
        "expect": {
          "rows": [
            { "has_request_id": true },
            { "has_request_id": true },
            { "has_request_id": true }
          ]
        }
      }
    ],
    "rows": ["app.users"]
  }
]
