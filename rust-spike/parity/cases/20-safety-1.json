[
  {
    "name": "safety: member isolation, another member's task reads as missing",
    "source": "Hard invariant: private by default; owner-only unless shared",
    "seed": [
      "insert into app.task_lists (id, owner_user_id, name) values ('20000000-0000-4000-8000-000000000001','{{userA}}','Personal'),('20000000-0000-4000-8000-000000000002','{{userB}}','Personal')",
      "insert into app.tasks (id, owner_user_id, title, description, status, list_id) values ('30000000-0000-4000-8000-000000000001','{{userA}}','User A private task','A private description','todo','20000000-0000-4000-8000-000000000001'),('30000000-0000-4000-8000-000000000002','{{userB}}','User B private task','B private description','todo','20000000-0000-4000-8000-000000000002')"
    ],
    "steps": [
      {
        "id": "B reads A's task",
        "method": "GET",
        "path": "/api/tasks/30000000-0000-4000-8000-000000000001",
        "as": "B",
        "expect": {
          "status": 404
        }
      },
      {
        "id": "B edits A's task",
        "method": "PATCH",
        "path": "/api/tasks/30000000-0000-4000-8000-000000000001",
        "as": "B",
        "body": {
          "title": "Taken over"
        },
        "expect": {
          "status": 404
        }
      },
      {
        "id": "B reads A's activity",
        "method": "GET",
        "path": "/api/tasks/30000000-0000-4000-8000-000000000001/activity",
        "as": "B",
        "expect": {
          "status": 200,
          "body": {
            "activity": []
          }
        }
      },
      {
        "id": "B lists tasks",
        "method": "GET",
        "path": "/api/tasks",
        "as": "B",
        "expect": {
          "status": 200,
          "body": {
            "tasks": [
              {
                "title": "User B private task"
              }
            ]
          }
        }
      },
      {
        "id": "B probes A's tasks",
        "sql": "select count(*)::int as n from app.tasks where owner_user_id = '{{userA}}'",
        "as": "B",
        "expect": {
          "rows": [
            {
              "n": 0
            }
          ]
        }
      },
      {
        "id": "B probes A's items",
        "sql": "select count(*)::int as n from app.rls_probe_items where owner_user_id = '{{userA}}'",
        "as": "B",
        "expect": {
          "rows": [
            {
              "n": 0
            }
          ]
        }
      },
      {
        "id": "A reads own task",
        "method": "GET",
        "path": "/api/tasks/30000000-0000-4000-8000-000000000001",
        "as": "A",
        "expect": {
          "status": 200
        }
      },
      {
        "id": "A's task is unchanged",
        "sql": "select title from app.tasks where id = '30000000-0000-4000-8000-000000000001'",
        "as": "A",
        "expect": {
          "rows": [
            {
              "title": "User A private task"
            }
          ]
        }
      }
    ],
    "rows": ["app.tasks", "app.task_activity"],
    "note": "The activity list does not check that the task is visible, so another member's task answers 200 with an empty list on both servers. Row-level security hides the rows."
  },
