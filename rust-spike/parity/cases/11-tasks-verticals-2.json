  {
    "name": "verticals 697: moving a task drops tags from the old list",
    "source": "tasks-verticals.test.ts:697 moving a task to another list drops tags foreign to the destination",
    "steps": [
      {
        "id": "la",
        "method": "POST",
        "path": "/api/tasks/lists",
        "as": "A",
        "body": {
          "name": "A1"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "lb",
        "method": "POST",
        "path": "/api/tasks/lists",
        "as": "A",
        "body": {
          "name": "B1"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "taga",
        "method": "POST",
        "path": "/api/tasks/lists/{{la:/body/list/id}}/tags",
        "as": "A",
        "body": {
          "name": "only-A"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "t",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "body": {
          "title": "mover",
          "listId": "{{la:/body/list/id}}"
        },
        "expect": {
          "status": 201
        }
      },
      {
        "id": "assign",
        "method": "POST",
        "path": "/api/tasks/{{t:/body/task/id}}/tags",
        "as": "A",
        "body": {
          "tagId": "{{taga:/body/tag/id}}"
        },
        "expect": {
          "status": 200
        }
      },
      {
        "id": "move",
        "method": "PATCH",
        "path": "/api/tasks/{{t:/body/task/id}}",
        "as": "A",
        "body": {
          "listId": "{{lb:/body/list/id}}"
        },
        "expect": {
          "body": {
            "task": {
              "listId": "{{lb:/body/list/id}}"
            }
          },
          "status": 200
        }
      },
      {
        "id": "tags",
        "method": "GET",
        "path": "/api/tasks/{{t:/body/task/id}}",
        "as": "A",
        "expect": {
          "body": {
            "task": {
              "tags": []
            }
          },
          "status": 200
        }
      },
      {
        "id": "none left",
        "sql": "select count(*)::int as n from app.task_tag_assignments",
        "as": "A",
        "expect": {
          "rows": [
            {
              "n": 0
            }
          ]
        }
      }
    ],
    "rows": ["app.tasks", "app.task_tag_assignments"]
  },
