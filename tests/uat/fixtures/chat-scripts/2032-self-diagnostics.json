{
  "version": 1,
  "turns": [
    {
      "expectIncludes": ["UAT-2032-diagnose"],
      "calls": [
        {
          "tool": "settings.platformDiagnostics",
          "arguments": { "module": "news", "include": ["modules"] }
        }
      ],
      "reply": "News diagnostics report the latest attempt, latest success, current state, and item count."
    },
    {
      "expectIncludes": ["UAT-2032-refresh"],
      "calls": [{ "tool": "news.refreshNews", "arguments": {} }],
      "reply": "Refresh accepted and queued; it has not completed."
    },
    {
      "expectIncludes": ["UAT-2032-recheck"],
      "calls": [
        {
          "tool": "settings.platformDiagnostics",
          "arguments": { "module": "news", "include": ["modules"] }
        }
      ],
      "reply": "News is current after the refresh, with a new success time and item count."
    }
  ]
}
