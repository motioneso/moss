node_modules/
.pnpm-store/
.DS_Store
._*
dist/
coverage/
.turbo/
.codegraph/
.codebase-memory/
playwright-report/
test-results/
backups/
exports/
# Local test/verification artifacts (webwright runs, screenshots) — regenerable, may contain creds
outputs/
docs/testing/
.env
.env.*
!.env.example
# Backup operator env (holds PGPASSWORD etc.) — never commit
infra/backup.env
# Local prod-compose smoke env file (off-git; the *.env* globs miss the .local suffix)
infra/env.production.local

# Claude Code per-machine local settings (never commit)
.claude/settings.local.json

# Superpowers local server/runtime state; content snapshots may be committed intentionally.
.superpowers/**/state/

# Local design-system archive/import
Jarvis Design System.zip
Jarvis Design System/

# #996/#860: resolveModulesDir's dev fallback creates <repoRoot>/data/modules the first
# time a dev runs module-reconcile.ts locally — never commit it.
/data/

# #1326: three unit tests (external-worker-runtime, external-module-invocation-budget,
# module-sdk-worker) mkdtemp() their fixture directly under the repo root instead of
# os.tmpdir(), each cleaned up in afterEach. (Checked whether this is required for
# pnpm-workspace.yaml path resolution, per the known bundled-path-resolution trap: it
# is not — ExternalModuleWorkerRuntime.start() spawns the entrypoint with `cwd: module.dir`
# directly, worker-runtime.ts:230-231, and none of these three files reference
# resolveModulesDir or pnpm-workspace.yaml. The repo-root placement looks incidental.)
# Reproduced and confirmed the actual flake this prevents: ESLint's own glob-walk throws
# an unhandled ENOENT (`scandir`) if one of these directories disappears mid-scan, and
# Prettier flags the fixture's generated worker.js as a style violation while a test still
# holds it open.
.tmp-*/

# Claude Code session scratchpad
scratchpad/
# ...but not the @moss/scratchpad module package (#2236) - same folder name, different thing.
!packages/scratchpad/

# Append-only context telemetry written concurrently by every agent session. Nothing
# reads it (the 70% warning comes from the PostToolUse hook, not this file), and tracking
# it guarantees meaningless merge conflicts across parallel branches.
.claude/context-meter.log

# Spawn briefs handed to agents at launch. They are one-shot scratch prompts consumed at
# boot and never read again, but they accumulate in the shared checkout — 70+ of them at
# one point — where they show up as untracked noise in every agent's `git status` and red
# any gate run from inside a worktree that contains them.
.claude/boot-*.txt
docs/coordination/boot-*.txt
