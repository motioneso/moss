#!/usr/bin/env bash
# Isolated hosted-runner claims for tests that use the shared devports interface.
# This PATH entry is added only by CI; local gates keep the machine's allocator.
set -euo pipefail
claims="${RUNNER_TEMP:?CI runner only}/devports"
case "${1:-}" in
  claim)
    mkdir -p "$claims"
    for ((port=5180; port<=5299; port++)); do
      if ss -ltn "( sport = :$port )" | grep -q LISTEN; then continue; fi
      if mkdir "$claims/$port" 2>/dev/null; then
        echo "${2:?claim name required}" > "$claims/$port/owner"
        echo "$port"
        exit 0
      fi
    done
    echo 'No free CI port' >&2
    exit 1
    ;;
  release)
    port="${2:?port required}"
    [[ "$port" =~ ^[0-9]+$ ]] && ((port>=5180 && port<=5299))
    rm -rf "$claims/$port"
    ;;
  *) echo 'Use claim <name> or release <port>' >&2; exit 1 ;;
esac
