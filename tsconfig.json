{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@moss/auth": ["packages/auth/src/index.ts"],
      "@moss/ai": ["packages/ai/src/index.ts"],
      "@moss/briefings": ["packages/briefings/src/index.ts"],
      "@moss/calendar": ["packages/calendar/src/index.ts"],
      "@moss/chat": ["packages/chat/src/index.ts"],
      "@moss/chat/live": ["packages/chat/src/live/public.ts"],
      "@moss/chat/priority-consumer": ["packages/chat/src/priority-consumer.ts"],
      "@moss/connectors": ["packages/connectors/src/index.ts"],
      "@moss/connectors/presets": ["packages/connectors/src/imap-presets.ts"],
      "@moss/datasets": ["packages/datasets/src/index.ts"],
      "@moss/host-fetch": ["packages/host-fetch/src/index.ts"],
      "@moss/host-fetch/policy": ["packages/host-fetch/src/policy.ts"],
      "@moss/db": ["packages/db/src/index.ts"],
      "@moss/db/probes": ["packages/db/src/probes/index.ts"],
      "@moss/db/*": ["packages/db/src/*"],
      "@moss/email": ["packages/email/src/index.ts"],
      "@moss/jobs": ["packages/jobs/src/index.ts"],
      "@moss/jobs/*": ["packages/jobs/src/*"],
      "@moss/module-registry": ["packages/module-registry/src/index.ts"],
      "@moss/module-registry/node": ["packages/module-registry/src/node.ts"],
      "@moss/module-sdk": ["packages/module-sdk/src/index.ts"],
      "@moss/module-sdk/ai-capabilities": ["packages/module-sdk/src/ai-capabilities.ts"],
      "@moss/module-sdk/core-version": ["packages/module-sdk/src/core-version.ts"],
      "@moss/module-sdk/errors": ["packages/module-sdk/src/errors.ts"],
      "@moss/module-sdk/server": ["packages/module-sdk/src/server.ts"],
      "@moss/module-sdk/list-limits": ["packages/module-sdk/src/list-limits.ts"],
      "@moss/module-sdk/time": ["packages/module-sdk/src/time.ts"],
      "@moss/module-sdk/worker": ["packages/module-sdk/src/worker.ts"],
      "@moss/module-css-confine": ["packages/module-css-confine/src/index.ts"],
      "@moss/module-web-sdk": ["packages/module-web-sdk/src/index.ts"],
      "@moss/news": ["packages/news/src/index.ts"],
      "@moss/news/web": ["packages/news/src/web/index.tsx"],
      "@moss/notifications": ["packages/notifications/src/index.ts"],
      "@moss/priority": ["packages/priority/src/index.ts"],
      "@moss/settings": ["packages/settings/src/index.ts"],
      "@moss/settings-ui": ["packages/settings-ui/src/index.tsx"],
      "@moss/settings-ui/vite": ["packages/settings-ui/src/vite.ts"],
      "@moss/shared": ["packages/shared/src/index.ts"],
      "@moss/sports": ["packages/sports/src/index.ts"],
      "@moss/sports/web": ["packages/sports/src/web/index.tsx"],
      "@moss/workshop": ["packages/workshop/src/index.ts"],
      "@moss/workshop/web": ["packages/workshop/src/web/index.tsx"],
      "@moss/source-behaviors": ["packages/source-behaviors/src/index.ts"],
      "@moss/tasks": ["packages/tasks/src/index.ts"],
      "@moss/ui": ["packages/ui/src/index.ts"],
      "@moss/memory": ["packages/memory/src/index.ts"],
      "@moss/usefulness-feedback": ["packages/usefulness-feedback/src/index.ts"],
      "@moss/vault": ["packages/vault/src/index.ts"],
      "@moss/structured-state": ["packages/structured-state/src/index.ts"],
      "@moss/web-research": ["packages/web-research/src/index.ts"],
      "@moss/weather": ["packages/weather/src/index.ts"],
      "@moss/wellness": ["packages/wellness/src/index.ts"],
      "@moss/notes": ["packages/notes/src/index.ts"],
      "@moss/proactive-monitoring": ["packages/proactive-monitoring/src/index.ts"],
      "@moss/commitments": ["packages/commitments/src/index.ts"],
      "@moss/commitments/extractor": ["packages/commitments/src/extractor.ts"],
      "@moss/commitments/jobs": ["packages/commitments/src/jobs.ts"],
      "@moss/commitments/routes": ["packages/commitments/src/routes.ts"],
      "@moss/commitments/workers": ["packages/commitments/src/workers.ts"],
      "@moss/commitments/prefilter": ["packages/commitments/src/prefilter.ts"],
      "@moss/commitments/signature": ["packages/commitments/src/signature.ts"],
      "@moss/commitments/tools": ["packages/commitments/src/tools.ts"],
      "@moss/people": ["packages/people/src/index.ts"],
      "react": ["apps/web/node_modules/@types/react"],
      "react/jsx-runtime": ["apps/web/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["apps/web/node_modules/@types/react-dom"],
      "react-dom/client": ["apps/web/node_modules/@types/react-dom/client.d.ts"],
      "react-dom/server": ["apps/web/node_modules/@types/react-dom/server.d.ts"],
      "react-dom/test-utils": ["apps/web/node_modules/@types/react-dom/test-utils.d.ts"],
      "@tanstack/react-query": ["apps/web/node_modules/@tanstack/react-query"],
      "react-router": ["apps/web/node_modules/react-router"]
    }
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/web/src/vite-env.d.ts",
    "packages/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "spikes/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
