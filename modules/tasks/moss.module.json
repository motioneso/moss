{
  "schemaVersion": 2,
  "id": "tasks",
  "name": "Tasks",
  "description": "Tasks component checkpoint with validated basic routes and four read tools. Screens, remaining tools and jobs are unfinished.",
  "publisher": "Moss",
  "version": "0.1.0",
  "requiresMoss": ">=0.1.0, <1.0.0",
  "abi": "moss:module@1",
  "capabilities": [
    {
      "port": "db",
      "operations": ["query"],
      "resources": [
        "app.tasks",
        "app.task_lists",
        "app.task_tags",
        "app.task_tag_assignments",
        "app.task_activity",
        "app.task_preferences"
      ]
    },
    {
      "port": "context",
      "operations": ["read", "uuid"],
      "resources": ["call", "new"]
    }
  ],
  "database": {
    "ownedTables": [
      "app.tasks",
      "app.task_lists",
      "app.task_tags",
      "app.task_tag_assignments",
      "app.task_activity",
      "app.task_preferences"
    ],
    "migrations": [
      "sql/0003_tasks_module.sql",
      "sql/0006_tasks_drop_workspace_grants.sql",
      "sql/0019_tasks_owner_or_share.sql",
      "sql/0039_tasks_foundation.sql",
      "sql/0062_task_tag_assignments_ownership.sql",
      "sql/0063_tasks_fk_indexes.sql",
      "sql/0075_tasks_worker_recurrence_grant.sql",
      "sql/0140_task_status_suggested.sql",
      "sql/0178_task_suggestion_metadata.sql"
    ],
    "ledger": "core-legacy"
  },
  "navigation": [],
  "settings": [],
  "features": [
    {
      "id": "tasks.package-data",
      "description": "Tasks component routes with legacy request validation for task creation and updates, completion cascades, next recurrence, lists, tags, activity and view preferences. Four read tools fetch task details, lists, tags and activity. Full route parity, screens, remaining chat tools and background jobs are unfinished.",
      "errors": [
        {
          "code": "tasks-invalid-input",
          "class": "validation",
          "description": "A request has missing or invalid fields. Correct the field named in the validation message and retry."
        },
        {
          "code": "task-not-accessible",
          "class": "permission",
          "description": "A task or list is absent or unavailable to this account."
        },
        {
          "code": "tasks-host-error",
          "class": "bug",
          "description": "A data operation failed; internal details are withheld from the response."
        }
      ]
    }
  ],
  "screens": {},
  "icons": ["icons/tasks.svg"],
  "accounts": {
    "supportsUserDisable": false,
    "defaultEnabled": true
  },
  "routes": [
    {
      "method": "GET",
      "path": "/tasks",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/:id",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/:id/subtasks",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/preferences",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/lists",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/lists/:list_id/tags",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/tasks/:id/activity",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/tasks",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/tasks/lists",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/tasks/lists/:list_id/tags",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/tasks/:id/tags",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/tasks/:id/activity",
      "signIn": true
    },
    {
      "method": "PATCH",
      "path": "/tasks/:id",
      "signIn": true
    },
    {
      "method": "PATCH",
      "path": "/tasks/preferences",
      "signIn": true
    },
    {
      "method": "PATCH",
      "path": "/tasks/lists/:list_id",
      "signIn": true
    },
    {
      "method": "PATCH",
      "path": "/tasks/lists/:list_id/tags/:tag_id",
      "signIn": true
    },
    {
      "method": "DELETE",
      "path": "/tasks/:id/tags/:tag_id",
      "signIn": true
    },
    {
      "method": "DELETE",
      "path": "/tasks/lists/:list_id/tags/:tag_id",
      "signIn": true
    }
  ],
  "tools": {
    "tasks.get": {
      "description": "Get a task with its subtasks and ten most recent activity entries.",
      "risk": "read"
    },
    "tasks.listLists": {
      "description": "List the account’s task lists.",
      "risk": "read"
    },
    "tasks.listTags": {
      "description": "List tags in a task list.",
      "risk": "read"
    },
    "tasks.activity": {
      "description": "Read a task’s activity.",
      "risk": "read"
    }
  }
}
