[
  {
    "name": "package breakdown: ordered trimmed steps and parent activity",
    "source": "packages/tasks/src/routes.ts and breakdown.ts",
    "steps": [
      {
        "id": "parent",
        "method": "POST",
        "path": "/api/tasks",
        "as": "A",
        "expect": {
          "status": 201
        },
        "body": {
          "title": "Breakdown parent"
        }
      },
      {
        "id": "breakdown",
        "method": "POST",
        "path": "/api/tasks/{{parent:/body/task/id}}/breakdown",
        "as": "A",
        "expect": {
          "status": 201,
          "body": {
            "tasks": [
              {
                "title": "First",
                "position": 0
              },
              {
                "title": "2",
                "position": 1
              }
            ]
          }
        },
        "body": {
          "steps": ["  First  ", 2]
        }
      },
      {
        "id": "activity",
        "method": "GET",
        "path": "/api/tasks/{{parent:/body/task/id}}/activity",
        "as": "A",
        "expect": {
          "status": 200,
          "body": {
            "activity": [
              {
                "activityType": "broken_down",
                "body": "Broken into 2 steps"
              }
            ]
          }
        }
      }
    ],
    "rows": ["app.tasks", "app.task_activity"]
  },
