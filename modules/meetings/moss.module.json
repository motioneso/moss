  "requires": {},
  "provides": {
    "prepareMeetingRoute": "1.0.0",
    "collectMeetingsExportSection": "1.0.0"
  },
  "icons": ["icons/meetings.svg"],
  "accounts": {
    "supportsUserDisable": true,
    "defaultEnabled": true
  },
  "lifecycle": {
    "required": false,
    "bundled": true,
    "removable": true
  },
  "jobs": {
    "meetings.recording-notice": {
      "meeting-id": {
        "kind": "id"
      }
    },
    "meetings.stop-summary": {
      "meeting-id": {
        "kind": "id"
      }
    },
    "meetings.recording-import": {
      "meeting-id": {
        "kind": "id"
      }
    }
  },
  "navigation": [],
  "settings": [
    {
      "id": "meetings.module-settings",
      "label": "Meetings",
      "path": "/settings?section=modules&module=meetings",
      "scope": "user",
      "description": "Recording audio, transcript language, vocabulary and automatic summary defaults are saved with your account. Changing them from Settings is not available in this version yet; they can be read and saved through the Meetings routes."
    }
  ],
  "features": [
    {
      "id": "meetings.records",
      "description": "Each person keeps private meeting records with a title and personal notes. Titles are at most 240 bytes and notes at most 64,000 bytes. Notes save with a version check, so a stale edit is refused and returns the current notes. A repeated request key returns the original result. Deleting a meeting is permanent. Nobody else, including admins, can see them.",
      "errors": [
        {
          "code": "meeting_invalid_input",
          "class": "validation",
          "description": "The title, notes or request is not valid"
        },
        {
          "code": "meeting_not_found",
          "class": "validation",
          "description": "The meeting does not exist or is not yours"
        },
        {
          "code": "meeting_notes_conflict",
          "class": "validation",
          "description": "The notes changed since you opened them; the current notes are returned"
        },
        {
          "code": "meeting_title_conflict",
          "class": "validation",
          "description": "The title changed since you opened it; the current title is returned"
        },
        {
          "code": "meeting_request_conflict",
          "class": "validation",
          "description": "This request key was already used with different content"
        }
      ]
    },
    {
      "id": "meetings.preferences",
      "description": "Saves the default recording audio, the remembered recording source, automatic summaries on Stop, the summary style, the transcript language and best-effort vocabulary for the account. Reading never creates a default. The Meetings screen and Settings controls are not part of this package yet.",
      "errors": [
        {
          "code": "meeting_capture_invalid_input",
          "class": "validation",
          "description": "A recording default is not valid"
        },
        {
          "code": "meeting_vocabulary_invalid",
          "class": "validation",
          "description": "The vocabulary list is not valid"
        }
      ]
    },
    {
      "id": "meetings.transcripts",
      "description": "Saves a meeting transcript as numbered batches and reads it back. A batch is applied in order, a repeated request key returns the original receipt, and a stale version is refused. Reads return at most 500 segments and 100,000 characters, and a single segment can be read as evidence with a character range. A meeting holds at most 4,096 batches, 20,000 revisions and 32 MiB. Only the meeting owner can save or read, and admins cannot.",
      "errors": [
        {
          "code": "meeting_transcript_invalid_input",
          "class": "validation",
          "description": "The transcript batch is not valid"
        },
        {
          "code": "meeting_transcript_limit",
          "class": "validation",
          "description": "The transcript is over a size or count limit"
        },
        {
          "code": "meeting_transcript_request_conflict",
          "class": "validation",
          "description": "This request key was already used with different content"
        },
        {
          "code": "meeting_transcript_version_conflict",
          "class": "validation",
          "description": "The transcript changed since the batch was prepared; the current receipt is returned"
        },
        {
          "code": "meeting_transcript_unavailable",
          "class": "validation",
          "description": "The meeting has no transcript you can read"
        },
        {
          "code": "meeting_not_found",
          "class": "validation",
          "description": "The meeting does not exist or is not yours"
        }
      ]
    },
    {
      "id": "meetings.history",
      "description": "Finds your own meetings by words in the title, notes or transcript, with filters for transcript, needs review, exported and notes only, and pages through them newest first. A search can use at most 16 words. Replies are never cached, and nobody else, including admins, sees your meetings.",
      "errors": [
        {
          "code": "meeting_history_invalid_input",
          "class": "validation",
          "description": "The search is not valid"
        },
        {
          "code": "meeting_history_unavailable",
          "class": "transient",
          "description": "History could not be read right now"
        },
        {
          "code": "meeting_not_found",
          "class": "validation",
          "description": "The meeting does not exist or is not yours"
        }
      ]
    }
  ],
  "screens": {}
}
