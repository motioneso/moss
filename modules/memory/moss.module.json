{
  "schemaVersion": 2,
  "id": "memory",
  "name": "Memory",
  "description": "Keeps what Moss remembers for each account and sets up the model that turns note text into searchable vectors. Graph access, recall, remembering and the Memory screen are not part of this package yet.",
  "publisher": "Moss",
  "version": "0.1.0",
  "requiresMoss": ">=0.1.0, <1.0.0",
  "abi": "moss:module@1",
  "capabilities": [
    {
      "port": "db",
      "operations": ["query"],
      "resources": ["app.memory_ingest_nudges"]
    },
    {
      "port": "vault",
      "operations": [
        "index.vault-list",
        "index.vault-file",
        "index.vault-remove",
        "index.vault-purge"
      ],
      "resources": ["vault-index"]
    },
    {
      "port": "jobs",
      "operations": ["enqueue-after-commit", "enqueue-options", "schedule"],
      "resources": [
        "memory.vault-ingest-tick",
        "memory.vault-ingest-sweep",
        "memory.vault-ingest-nudge"
      ]
    },
    {
      "port": "context",
      "operations": ["uuid", "read"],
      "resources": ["new", "call"]
    }
  ],
  "database": {
    "migrations": [
      "sql/0030_memory_index.sql",
      "sql/0032_memory_embedding_768.sql",
      "sql/0040_memory_chat_source.sql",
      "sql/0041_memory_facts.sql",
      "sql/0054_worker_memory_rls.sql",
      "sql/0061_memory_facts_to_role.sql",
      "sql/0064_chat_memory_facts_source_thread_idx.sql",
      "sql/0090_chat_memory_facts_provenance.sql",
      "sql/0092_inferred_patterns_suppression.sql",
      "sql/0094_chat_memory_facts_rls_roles.sql",
      "sql/0096_chat_memory_corrections_log.sql",
      "sql/0097_chat_memory_corrections_update_grant.sql",
      "sql/0106_memory_notes_source_kind.sql",
      "sql/0110_memory_links_worker_write.sql",
      "sql/0118_memory_graph_substrate.sql",
      "sql/0119_memory_candidates.sql",
      "sql/0121_confidence_aware_memory_records.sql",
      "sql/0281_memory_screen_source_kind.sql",
      "sql/0301_superseded_by_set_null_on_delete.sql",
      "sql/0338_memory_managed_note_snapshots.sql",
      "sql/0339_memory_recording_lineage.sql",
      "sql/0341_memory_recording_cleanup.sql",
      "sql/0363_memory_ingest_nudges.sql"
    ],
    "ownedTables": [
      "app.memory_chunks",
      "app.memory_links",
      "app.memory_file_index",
      "app.chat_memory_facts",
      "app.memory_entities",
      "app.memory_facts",
      "app.memory_episodes",
      "app.memory_fact_sources",
      "app.memory_aliases",
      "app.memory_search_documents",
      "app.memory_legacy_fact_migrations",
      "app.memory_conflict_groups",
      "app.memory_candidates",
      "app.memory_recording_fact_versions",
      "app.memory_recording_receipts",
      "app.memory_recording_proposals",
      "app.memory_ingest_nudges"
    ],
    "ledger": "core-legacy",
    "access": {
      "app.memory_chunks": {
        "access": "owner-only"
      },
      "app.memory_links": {
        "access": "owner-only"
      },
      "app.memory_file_index": {
        "access": "owner-only"
      },
      "app.chat_memory_facts": {
        "access": "owner-only"
      },
      "app.memory_entities": {
        "access": "owner-only"
      },
      "app.memory_facts": {
        "access": "owner-only"
      },
      "app.memory_episodes": {
        "access": "owner-only"
      },
      "app.memory_fact_sources": {
        "access": "owner-only"
      },
      "app.memory_aliases": {
        "access": "owner-only"
      },
      "app.memory_search_documents": {
        "access": "owner-only"
      },
      "app.memory_legacy_fact_migrations": {
        "access": "owner-only"
      },
      "app.memory_conflict_groups": {
        "access": "owner-only"
      },
      "app.memory_candidates": {
        "access": "owner-only"
      },
      "app.memory_recording_fact_versions": {
        "access": "owner-only"
      },
      "app.memory_recording_receipts": {
        "access": "owner-only"
      },
      "app.memory_recording_proposals": {
        "access": "owner-only"
      },
      "app.memory_ingest_nudges": {
        "access": "owner-only"
      }
    }
  },
  "routes": [{ "method": "POST", "path": "/vault-index/start", "signIn": true }],
  "requires": {},
  "provides": {
    "requestVaultIndex": "1.0.0"
  },
  "icons": ["icons/memory.svg"],
  "accounts": {
    "supportsUserDisable": false,
    "defaultEnabled": true
  },
  "lifecycle": {
    "required": true,
    "bundled": true,
    "removable": false
  },
  "features": [
    {
      "id": "memory.vault-index",
      "description": "Each account's notes are split into searchable pieces and indexed every fifteen minutes, covering the private note copies Moss saves and the folder named in the account's people notes preference. The Attachments and Exports folders are never indexed. Changed files are re-indexed, deleted files are dropped, and a change of search model re-indexes everything once. A restart does not re-index. Other modules can ask for one saved note copy to be indexed sooner through the requestVaultIndex API. Search and the Memory screen are not part of this package yet.",
      "errors": [
        {
          "code": "memory-index-unavailable",
          "class": "transient",
          "description": "A note could not be indexed this time. The next scheduled run tries it again.",
          "remediationRef": "memory-set-up-embedding"
        }
      ],
      "remediations": [
        {
          "id": "memory-set-up-embedding",
          "description": "Check the search model settings",
          "path": "/settings/memory"
        }
      ]
    },
    {
      "id": "memory.embedding",
      "description": "Sets the model that turns note text into searchable vectors. Admins save an endpoint address, a model name and an optional key. The key is sealed on save and never shown again. Note text is sent to that endpoint, and the screen says so before saving. Running the model on this device is not available yet.",
      "errors": [
        {
          "code": "embedding-not-set-up",
          "class": "validation",
          "description": "No embedding model is set up",
          "remediationRef": "memory-set-up-embedding"
        },
        {
          "code": "embedding-endpoint-unreachable",
          "class": "transient",
          "description": "The embedding endpoint did not return a usable answer",
          "remediationRef": "memory-set-up-embedding"
        }
      ],
      "remediations": [
        {
          "id": "memory-set-up-embedding",
          "description": "Set up an embedding model",
          "path": "/settings/memory"
        }
      ]
    }
  ],
  "tools": {},
  "jobs": {
    "memory.vault-ingest-tick": {},
    "memory.vault-ingest-sweep": {
      "offset": {
        "kind": "count"
      }
    },
    "memory.vault-ingest-nudge": {
      "nudge-id": {
        "kind": "id"
      }
    }
  },
  "screens": {
    "/settings/memory": "ui/index.html"
  },
  "navigation": [],
  "settings": [
    {
      "id": "memory.embedding",
      "label": "Memory search model",
      "path": "/settings/memory",
      "scope": "admin",
      "description": "The endpoint and model that turn note text into searchable vectors for every account. Note text is sent to the endpoint you choose. Running the model on this device is not available yet."
    }
  ]
}
