  "features": [
    {
      "id": "finance.accounts",
      "description": "A person can list their own accounts with current balances, currencies and, for manual accounts, the opening date and balance. With no accounts, the list suggests adding a manual account. Accounts shared by other people and bank links are not built yet. No screen is built yet.",
      "errors": [
        {
          "code": "finance_accounts_unavailable",
          "class": "transient",
          "description": "Accounts could not be read. Try again in a moment."
        }
      ]
    },
    {
      "id": "finance.manual-accounts",
      "description": "A person can add a private manual account (checking, savings, cash, credit, loan or asset) in one of twelve currencies, with an opening date that is not in the future and an opening balance. Repeating the same operation id with the same values changes nothing. The assistant's version needs the account's one-use approval. No bank money is moved.",
      "errors": [
        {
          "code": "invalid_input",
          "class": "validation",
          "description": "A value was not accepted. Fix the field named in the message and try again."
        },
        {
          "code": "unsupported_currency",
          "class": "validation",
          "description": "Choose one of the twelve supported two-decimal currencies and try again."
        },
        {
          "code": "future_date",
          "class": "validation",
          "description": "The date is after today in your time zone. Choose today or an earlier date."
        },
        {
          "code": "manual_conflict",
          "class": "validation",
          "description": "This operation id already saved different values. Check the saved account and use a new operation id for a new one."
        }
      ]
    },
    {
      "id": "finance.manual-entries",
      "description": "A person can add a manual transaction to a manual account. It moves the account balance (down for cash-like accounts, up for credit and loans), needs a current category or is marked for a look, and cannot be dated before the account opened, in a reconciled period or in the future. Repeating the same operation id with the same values changes nothing. The assistant's version needs the account's one-use approval.",
      "errors": [
        {
          "code": "invalid_category",
          "class": "validation",
          "description": "Choose a current category. Linked transfers need their own workflow."
        },
        {
          "code": "manual_unavailable",
          "class": "validation",
          "description": "The manual account is missing, closed or uses a different currency. Check the account and try again."
        },
        {
          "code": "manual_invalid_date",
          "class": "validation",
          "description": "The date is before the account's opening date. Choose a later date."
        },
        {
          "code": "manual_reconciled_period",
          "class": "validation",
          "description": "The date falls in a reconciled statement period. Choose a later date."
        },
        {
          "code": "manual_overflow",
          "class": "validation",
          "description": "The new balance would be too large to store. Check the amount and try again."
        }
      ]
    }
  ],
  "credentials": {
    "plaid-keys": {
      "scope": "instance",
      "hosts": [
        "sandbox.plaid.com",
        "production.plaid.com"
      ],
      "attachment": {
        "kind": "fields",
        "name": {
          "client_id": "clientId",
          "secret": "clientSecret"
        }
      },
      "exposeFields": [
        "link_token",
        "public_token",
        "hosted_link_url",
        "expiration"
      ]
    },
    "plaid-item": {
      "scope": "account",
      "hosts": [
        "sandbox.plaid.com",
        "production.plaid.com"
      ],
      "attachment": {
        "kind": "fields",
        "name": {
          "access_token": "accessToken"
        }
      },
      "with": [
        "plaid-keys"
      ],
      "exchange": {
        "endpoint": "https://production.plaid.com/item/public_token/exchange",
        "grantType": "token_swap",
        "format": "json",
        "input": "public_token"
      }
    }
  },
  "jobs": {
