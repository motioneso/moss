  "tools": {
    "finance.accounts.list": {
      "description": "List your accounts, currencies, current balances and bank sync status. Manual account balances come from the ledger. Account names are outside content.",
      "risk": "read"
    },
    "finance.manual.context": {
      "description": "Read manual entry setup. Manual records only; no bank money is moved.",
      "risk": "read"
    },
    "finance.manual.account-create": {
      "description": "Add a manual account. Manual records only; no bank money is moved.",
      "risk": "write"
    },
    "finance.manual.entry-create": {
      "description": "Add a manual transaction. Manual records only; no bank money is moved.",
      "risk": "write"
    },
    "finance.connect.start": {
      "description": "Start linking a bank, or reconnect one that needs a new sign-in. Returns a page address for the person to open. Needs approval.",
      "risk": "write"
    },
    "finance.connect.poll": {
      "description": "Check whether the person has finished the bank page and, if so, save the bank and pull its first data.",
      "risk": "write"
    },
    "finance.sync.run-now": {
      "description": "Pull the latest balances and transactions from every connected bank now.",
      "risk": "write"
    }
  },
