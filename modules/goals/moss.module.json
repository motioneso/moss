{
  "schemaVersion": 2,
  "id": "goals",
  "name": "Goals",
  "description": "Private long-running goals and evidence, with five chat tools under the host's approval rules and an active-goals data call for Today. The Today screen shows active goals. No memory sync jobs yet.",
  "publisher": "Moss",
  "version": "0.1.3",
  "requiresMoss": ">=0.1.0, <1.0.0",
  "fuelLimit": 200000000,
  "abi": "moss:module@1",
  "capabilities": [
    {
      "port": "db",
      "operations": ["query"],
      "resources": ["app.moss_goals", "app.moss_goal_evidence"]
    },
    {
      "port": "context",
      "operations": ["read"],
      "resources": ["call"]
    },
    {
      "port": "tools",
      "operations": ["offer", "run"],
      "resources": ["goals.list", "goals.get", "goals.create", "goals.update", "goals.addEvidence"]
    }
  ],
  "database": {
    "migrations": [
      "sql/0123_long_running_goals.sql",
      "sql/0182_moss_rename_goals.sql",
      "sql/0300_goals_id_defaults.sql"
    ],
    "ownedTables": ["app.moss_goals", "app.moss_goal_evidence"],
    "ledger": "core-legacy",
    "access": {
      "app.moss_goals": {
        "access": "owner-only"
      },
      "app.moss_goal_evidence": {
        "access": "owner-only"
      }
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/goals",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/goals",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/goals/:id",
      "signIn": true
    },
    {
      "method": "PATCH",
      "path": "/goals/:id",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/goals/:id/evidence",
      "signIn": true
    },
    {
      "method": "GET",
      "path": "/goals/today",
      "signIn": true
    },
    {
      "method": "POST",
      "path": "/goals/tools/run",
      "signIn": true
    }
  ],
  "requires": {},
  "provides": {
    "prepareChatAction": "1.0.0"
  },
  "icons": ["icons/goals.svg"],
  "accounts": {
    "supportsUserDisable": false,
    "defaultEnabled": true
  },
  "lifecycle": {
    "required": true,
    "bundled": true,
    "removable": false
  },
  "screens": {
    "/goals/today": "ui/today.html"
  },
  "navigation": [],
  "settings": [
    {
      "id": "goals.module-settings",
      "label": "Goals",
      "path": "/settings?section=modules&module=goals",
      "scope": "user",
      "description": "Goals can be reached through the Goals routes. Goals has no settings page, as before."
    }
  ],
  "features": [
    {
      "id": "goals.list-create-change-close",
      "description": "A person can list their goals in priority order, create a goal, change it, and close it by marking it completed or archived. Each person sees only their own goals.",
      "errors": [
        {
          "code": "goal_not_found",
          "class": "validation",
          "description": "The goal does not exist or belongs to another person. Check the goal and try again."
        },
        {
          "code": "goal_closed",
          "class": "validation",
          "description": "The goal is completed or archived, so new evidence is refused. Reopen the goal to add evidence."
        }
      ]
    },
    {
      "id": "goals.evidence",
      "description": "A person can add evidence to a goal that is still open, with its kind, source and summary. Adding evidence updates the goal's updated time.",
      "errors": []
    },
    {
      "id": "goals.chat-tools",
      "description": "Moss can read, create and change goals and add evidence. Ordinary changes run without a card unless you have chosen to approve them. Cards show the proposed values and completed changes show before and after values. Source labels and references are shown as proposed evidence values. Oversized approval cards are refused; long completed values are marked as truncated."
    },
    {
      "id": "goals.today-data",
      "description": "The Today data call returns only the signed-in person’s active goals in priority order, newest first at equal priority. An empty list stays empty. The Today screen uses this call.",
      "errors": []
    },
    {
      "id": "goals.today-screen",
      "description": "Today shows the signed-in person’s active goals under Focus and Long-term goals, with their target icon, priority and desired outcome, in the existing priority order. Completed and archived goals stay hidden. An empty list draws nothing. Loading is a quiet status line; a failed request offers Retry. This package screen has no editing or settings controls.",
      "errors": [
        {
          "code": "goals-screen-request-failed",
          "class": "transient",
          "description": "Your goals could not be loaded. Retry the request, or reload Today if the screen itself could not open."
        }
      ]
    }
  ],
  "tools": {
    "goals.list": {
      "description": "List all goals in priority order.",
      "risk": "read",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "goals.get": {
      "description": "Read a goal and its ten newest evidence summaries.",
      "risk": "read",
      "inputSchema": {
        "type": "object",
        "required": ["goalId"],
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Goal identifier from Goals."
          }
        }
      }
    },
    "goals.create": {
      "description": "Create a long-running goal.",
      "risk": "write",
      "card": "prepareChatAction",
      "inputSchema": {
        "type": "object",
        "required": ["title", "desiredOutcome"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Title to save."
          },
          "desiredOutcome": {
            "type": "string",
            "description": "What success looks like."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Priority from one (lowest) to five (highest)."
          },
          "reviewCadence": {
            "type": "string",
            "enum": ["none", "daily", "weekly", "biweekly", "monthly", "custom"],
            "description": "How often to review this goal."
          },
          "targetAt": {
            "type": "string",
            "description": "Target date and time in ISO 8601."
          }
        },
        "examples": [
          {
            "title": "Buy milk",
            "desiredOutcome": "Walk every weekday"
          }
        ]
      }
    },
    "goals.update": {
      "description": "Change or close a goal.",
      "risk": "write",
      "card": "prepareChatAction",
      "inputSchema": {
        "type": "object",
        "required": ["goalId"],
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Goal identifier from Goals."
          },
          "title": {
            "type": "string",
            "description": "Title to save."
          },
          "desiredOutcome": {
            "type": "string",
            "description": "What success looks like."
          },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "blocked", "completed", "archived"],
            "description": "New status."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Priority from one (lowest) to five (highest)."
          },
          "reviewCadence": {
            "type": "string",
            "enum": ["none", "daily", "weekly", "biweekly", "monthly", "custom"],
            "description": "How often to review this goal."
          },
          "targetAt": {
            "type": "string",
            "description": "Target date and time in ISO 8601."
          }
        },
        "examples": [
          {
            "goalId": "22222222-2222-4222-8222-222222222222"
          }
        ]
      }
    },
    "goals.addEvidence": {
      "description": "Add evidence to an open goal.",
      "risk": "write",
      "card": "prepareChatAction",
      "inputSchema": {
        "type": "object",
        "required": ["goalId", "evidenceKind", "sourceKind", "sourceLabel", "summary"],
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Goal identifier from Goals."
          },
          "evidenceKind": {
            "type": "string",
            "enum": [
              "context",
              "task",
              "status",
              "progress",
              "blocker",
              "decision",
              "checkpoint",
              "suggested_action"
            ],
            "description": "Kind of evidence."
          },
          "sourceKind": {
            "type": "string",
            "enum": ["goal", "task", "note", "email", "calendar", "chat", "memory", "manual"],
            "description": "Kind of source."
          },
          "sourceRef": {
            "type": "string",
            "description": "Reference to the source."
          },
          "sourceLabel": {
            "type": "string",
            "description": "Human-readable source name."
          },
          "summary": {
            "type": "string",
            "description": "Evidence summary."
          },
          "occurredAt": {
            "type": "string",
            "description": "When the evidence occurred, in ISO 8601."
          }
        },
        "examples": [
          {
            "goalId": "22222222-2222-4222-8222-222222222222",
            "evidenceKind": "context",
            "sourceKind": "goal",
            "sourceLabel": "Chat",
            "summary": "Walked today"
          }
        ]
      }
    }
  }
}
